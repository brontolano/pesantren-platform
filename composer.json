{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "*",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "*",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "*",
        "spatie/laravel-permission": "*",
        "stancl/tenancy": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Core\\": "Modules/Core/app/",
            "Modules\\Core\\Database\\Seeders\\": "Modules/Core/database/seeders/",
            "Modules\\Hello\\": "Modules/Hello/app/",
            "Modules\\Hello\\Database\\Seeders\\": "Modules/Hello/database/seeders/",
            "Modules\\Keuangan\\": "Modules/Keuangan/app/",
            "Modules\\Keuangan\\Database\\Seeders\\": "Modules/Keuangan/database/seeders/",
            "Modules\\Kesantrian\\": "Modules/Kesantrian/app/",
            "Modules\\Kesantrian\\Database\\Seeders\\": "Modules/Kesantrian/database/seeders/",
            "Modules\\Notifikasi\\": "Modules/Notifikasi/app/",
            "Modules\\Notifikasi\\Database\\Seeders\\": "Modules/Notifikasi/database/seeders/",
            "Modules\\PPDB\\": "Modules/PPDB/app/",
            "Modules\\PPDB\\Database\\Seeders\\": "Modules/PPDB/database/seeders/",
            "Modules\\CMS\\": "Modules/CMS/app/",
            "Modules\\CMS\\Database\\Seeders\\": "Modules/CMS/database/seeders/",
            "Modules\\Akademik\\": "Modules/Akademik/app/",
            "Modules\\Akademik\\Database\\Seeders\\": "Modules/Akademik/database/seeders/",
            "Modules\\Asrama\\": "Modules/Asrama/app/",
            "Modules\\Asrama\\Database\\Seeders\\": "Modules/Asrama/database/seeders/",
            "Modules\\Tahfidz\\": "Modules/Tahfidz/app/",
            "Modules\\Tahfidz\\Database\\Seeders\\": "Modules/Tahfidz/database/seeders/",
            "Modules\\Kesehatan\\": "Modules/Kesehatan/app/",
            "Modules\\Kesehatan\\Database\\Seeders\\": "Modules/Kesehatan/database/seeders/",
            "Modules\\Kegiatan\\": "Modules/Kegiatan/app/",
            "Modules\\Kegiatan\\Database\\Seeders\\": "Modules/Kegiatan/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
