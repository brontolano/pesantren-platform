APP_NAME="Pesantren.online v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://platform-v2.test

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pesantren_v2_central
DB_USERNAME=pesantren_v2
DB_PASSWORD=
DB_PROVISIONER_USERNAME=postgres
DB_PROVISIONER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
PLATFORM_SESSION_COOKIE=po_v2_platform_session
TENANT_SESSION_COOKIE=po_v2_tenant_session

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@pesantren-v2.test"
MAIL_FROM_NAME="Pesantren.online v2"

TENANT_INVITATION_TTL_MINUTES=30
TENANT_DATABASE_PREFIX=po_v2_t_
TENANT_STORAGE_ROOT=app/private/tenants
TENANT_TEST_DRIVER=sqlite
TENANT_DEMO_DOMAIN=demo-pesantren-v2.test
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=
