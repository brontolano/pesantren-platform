{
	frankenphp
	order php_server before file_server

	# On-demand TLS: terbitkan sertifikat per-domain saat handshake pertama.
	# Caddy bertanya ke endpoint Laravel apakah domain diizinkan (central / tenant terdaftar).
	on_demand_tls {
		ask http://localhost/caddy/ssl-check
	}
}

# ──────────────────────────────────────────────────────────────
# Website tenant: Pondok Pesantren Asy-Syifaa (asy-syifaa.com)
# PHP native thin-client, dilayani container terpisah
# (website-nginx + website-php, lihat docker-compose.production.yml).
# Sertifikat Let's Encrypt otomatis — DNS sudah mengarah ke VPS ini.
# ──────────────────────────────────────────────────────────────
asy-syifaa.com {
	encode zstd br gzip
	reverse_proxy website-nginx:80
}

www.asy-syifaa.com {
	redir https://asy-syifaa.com{uri} permanent
}

# ── Automasi (n8n + WAHA), dilayani container terpisah ──
n8n.asy-syifaa.com {
	encode zstd br gzip
	reverse_proxy n8n:5678
}

waha.asy-syifaa.com {
	encode zstd br gzip
	reverse_proxy waha:3000
}

# Redirect HTTP → HTTPS untuk domain website (host-match menang atas catch-all :80)
http://asy-syifaa.com, http://www.asy-syifaa.com {
	redir https://asy-syifaa.com{uri} permanent
}

# ── Route tenant dedicated (T2, issue #342) ──
# Peta domain→container per tenant sebagai file include (caddy/tenants/*.caddy,
# bind-mount dari repo — lihat docker-compose.production.yml). Host-match eksplisit
# menang atas catch-all di bawah. Tambah/hapus route TANPA rebuild:
#   docker exec pesantren-app caddy reload --config /etc/caddy/Caddyfile
# Glob tanpa file yang cocok = aman (tidak error).
import /etc/caddy/tenants/*.caddy

# HTTP — melayani app + tantangan ACME + endpoint ssl-check
:80 {
	root * /app/public
	encode zstd br gzip

	# Pusat Panduan statis (public/dokumentasi) — route eksplisit agar URL
	# direktori (mis. /dokumentasi/bendahara/) dilayani index.html oleh
	# file_server, bukan jatuh ke index.php Laravel (404).
	@dokumentasi path /dokumentasi /dokumentasi/*
	route @dokumentasi {
		file_server
	}

	php_server
}

# HTTPS — sertifikat otomatis (on-demand) untuk pesantren.online & semua subdomain tenant
:443 {
	tls {
		on_demand
	}
	root * /app/public
	encode zstd br gzip

	# Pusat Panduan statis — lihat catatan di blok :80
	@dokumentasi path /dokumentasi /dokumentasi/*
	route @dokumentasi {
		file_server
	}

	php_server
}
