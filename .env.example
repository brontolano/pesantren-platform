APP_NAME="Pesantren Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pesantren_platform
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Modul AI "Khadim Digital" (T-A001) ---
# LLM lokal self-hosted (container internal, tidak diekspos keluar VPS).
OLLAMA_BASE_URL=http://ollama:11434
# Timeout gateway (detik): chat 120, embedding 30.
AI_GATEWAY_TIMEOUT_CHAT=120
AI_GATEWAY_TIMEOUT_EMBED=30
# Circuit breaker: buka setelah N kegagalan dalam jendela W dtk, cooldown C dtk.
AI_CB_FAILURE_THRESHOLD=5
AI_CB_WINDOW_SECONDS=300
AI_CB_COOLDOWN_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- DNS custom domain tenant (Refs #350) ---
# IP publik VPS platform (target A record custom domain).
PLATFORM_SERVER_IP=187.77.116.167
# Token API Hostinger (https://developers.hostinger.com) untuk otomasi A record.
# Opsional — kosong = opsi "Otomatis" di UI nonaktif, opsi manual tetap jalan.
HOSTINGER_API_TOKEN=

# --- F6 Web Push (VAPID) — kanal PELENGKAP, WA tetap kanal utama ---
# JANGAN commit kunci asli. Generate baru per lingkungan (mis. Minishlink\WebPush\VAPID::createVapidKeys())
# dan set via ENV VPS sebelum aktivasi produksi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
